# Copy this file to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real keys.

# --- Shopping data -------------------------------------------------------------
# Google Shopping results via SerpApi. Free plan: 250 searches/month. https://serpapi.com
# Without this key the site runs on demo data.
SERPAPI_API_KEY=

# Optional, US only, free: eBay Browse API keys (https://developer.ebay.com).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: eBay Partner Network campaign id, to earn commission on eBay clicks.
EBAY_CAMPAIGN_ID=

# --- Database (price history, alerts, shared cache, rate limits) ---------------
# Postgres connection string. Easiest: Vercel → Storage → Neon (free), which sets this for you.
DATABASE_URL=

# --- Email (price-drop alerts) -------------------------------------------------
# https://resend.com — free plan: 3,000 emails/month. Needs a verified domain to email anyone
# other than yourself.
RESEND_API_KEY=
# Where to send warnings when live searches are running low (you, the site owner).
OWNER_EMAIL=
EMAIL_FROM="Stealz <alerts@gostealz.com>"

# Public URL used in email links.
APP_URL=https://www.gostealz.com

# Any long random string. Vercel sends it to the daily price-check job.
CRON_SECRET=

# --- Limits (optional) ---------------------------------------------------------
# Live searches cost SerpApi credits; these protect your plan from heavy traffic.
MONTHLY_LIVE_SEARCHES=240
DAILY_LIVE_SEARCHES=40
SEARCHES_PER_IP_PER_HOUR=20
# How long a search result is reused before it's fetched again (hours).
CACHE_TTL_HOURS=6
# Products with alerts re-checked per daily run (each uses 1 credit).
MAX_ALERT_CHECKS_PER_RUN=3
# auto = demo data until a data source key is set; on = always demo; off = never demo.
DEMO_MODE=auto
