{
  "manifest_version": 3,
  "name": "Stealz: compare prices",
  "short_name": "Stealz",
  "version": "1.0.0",
  "description": "On any product page, see what the same item costs at other stores with shipping and tax, which is cheapest, and other colors.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Compare prices with Stealz",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.gostealz.com/*"]
}
